{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Desktop 中文助手",
  "version": "0.1.0",
  "identifier": "local.claude.desktop.zh.cn",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build --prefix ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Desktop 中文助手",
        "width": 1280,
        "height": 860,
        "minWidth": 920,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": []
  }
}
